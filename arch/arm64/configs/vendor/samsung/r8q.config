# Project
CONFIG_SEC_R8Q_PROJECT=y
CONFIG_MACH_R8Q_EUR_OPEN=y

# CPU Governors & Power Efficiency
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y

CONFIG_CPU_IDLE=y
CONFIG_ARM_CPUIDLE=y
CONFIG_SCHEDUTIL=y
CONFIG_SCHED_TUNE=y
CONFIG_UCLAMP_TASK=y
CONFIG_POWER_EFFICIENT_WORKQUEUE=y

# ZRAM / Memory Optimization
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_SWAP=y
CONFIG_SWAPPER=y

CONFIG_KZEROD=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_HUGEPAGE_POOL=y
CONFIG_HUGEPAGE_POOL_ALLOW_ALL=y
CONFIG_PROCESS_RECLAIM_IGNORE_ALL_TYPE=y

# Link-Time Optimization
CONFIG_LTO_CLANG=y
CONFIG_THINLTO=y
CONFIG_LTO_NONE=n

# Logging / Debugging - Disabled
CONFIG_PRINTK=n
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_FRAME_POINTER=n
CONFIG_LOG_BUF_SHIFT=14

# TCP Congestion Algorithms
CONFIG_MPTCP=y
CONFIG_DEFAULT_MPTCP_PM="default"
CONFIG_DEFAULT_MPTCP_SCHED="default"
CONFIG_TCP_CONG_LIA=y
CONFIG_TCP_CONG_OLIA=y
CONFIG_TCP_CONG_WVEGAS=y
CONFIG_TCP_CONG_BBR=y

# Android/Low Memory Enhancements
CONFIG_ANDROID_LOW_MEMORY_KILLER=y
CONFIG_ANDROID_TIMED_OUTPUT=y
CONFIG_ANDROID_BINDER_IPC=y

# Display
CONFIG_PANEL_EA8076A_AMS646UJ10_FHD=y

# Touchscreen / Fingerprint
CONFIG_SENSORS_GW9558X=y
CONFIG_TOUCHSCREEN_ZINITIX_ZT7650=y
CONFIG_TOUCHSCREEN_STM_FTS5CU56A=y
CONFIG_INPUT_SEC_SECURE_TOUCH=y

# Sound
CONFIG_SND_SOC_CS35L41=y

# Vibrator
CONFIG_SS_VIBRATOR=y
CONFIG_MOTOR_DRV_MAX77705=y

# Camera
CONFIG_SAMSUNG_FRONT_FIXED_FOCUS=y
CONFIG_SAMSUNG_OIS_MCU_STM32=y
CONFIG_SAMSUNG_SBI=y
CONFIG_SAMSUNG_REAR_TRIPLE=y
CONFIG_CAMERA_ADAPTIVE_MIPI=y
CONFIG_CAMERA_SSM_I2C_ENV=y

# Sensors
CONFIG_CERTIFY_HALL=y
CONFIG_SENSORS_FW_VENDOR=y
CONFIG_SENSORS_TCS3407=y
CONFIG_SENSORS_A96T3X6=y
CONFIG_SENSORS_A96T3X6_CRC_CHECK=y
CONFIG_SENSORS_A96T3X6_BLOCK_SAR_ONLY=y
CONFIG_SENSORS_A96T3X6_FORCE_FW_UPDATE=y

# Modem/Network
CONFIG_ESOC=y
CONFIG_ESOC_DEV=y
CONFIG_ESOC_CLIENT=y
CONFIG_ESOC_MDM_4x=y
CONFIG_ESOC_MDM_DRV=y

CONFIG_MSM_BT_POWER=y
CONFIG_BT_SLIM_QCA6390=y
CONFIG_QCA_CLD_WLAN=y
CONFIG_WCNSS_MEM_PRE_ALLOC=y
CONFIG_CLD_LL_CORE=y
CONFIG_CNSS2=y
CONFIG_CNSS2_QMI=y
CONFIG_CNSS_ASYNC=y
CONFIG_BUS_AUTO_SUSPEND=y
CONFIG_CNSS_QCA6390=y
CONFIG_CNSS_GENL=y

# Slimbus
CONFIG_SLIMBUS_MSM_NGD=y

# Remove Bloat / Disable
CONFIG_WIRELESS_TX_MODE=n
CONFIG_WIRELESS_FIRMWARE_UPDATE=n
CONFIG_SAMSUNG_NFC=n
CONFIG_NFC_FEATURE_SN100U=n
CONFIG_SEC_NFC_LOGGER=n
CONFIG_SEC_CNSS2=n
CONFIG_USE_CAMERA_HW_BIG_DATA=n
CONFIG_MST_LDO=n
CONFIG_MST_V2=n
CONFIG_WIRELESS_AUTH=n
CONFIG_WIRELESS_CHARGER_HAL_MFC=y
CONFIG_WIRELESS_CHARGER_MFC=y
CONFIG_DISABLE_MFC_IC=y

# Final Cleanups
CONFIG_LEDS_KTD2692=y
CONFIG_LEDS_RT8547=y
